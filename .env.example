# HealPoint mobile client - environment template
#
# Copy this file to `.env` and set the values below.
# Only EXPO_PUBLIC_* variables are exposed to the mobile app. Never put
# secrets here (JWT secrets, Google client secrets, DB passwords, SMTP...).

# ---------------------------------------------------------------------------
# Backend API base URL
# ---------------------------------------------------------------------------
# Leave EMPTY to auto-detect the dev machine's LAN IP from the Metro host at
# runtime (best default for physical devices on the same Wi-Fi).
#
# For a guaranteed config run once on the dev machine:
#   npm run detect:ip
# which writes your laptop's real Wi-Fi IP here, e.g.:
#   EXPO_PUBLIC_API_URL=http://192.168.1.34:8080/api/v1
#
# NEVER use localhost / 127.0.0.1 for a physical Android phone.
EXPO_PUBLIC_API_URL=

# ---------------------------------------------------------------------------
# Google Sign-In (optional)
# ---------------------------------------------------------------------------
# Google OAuth client IDs (public - safe to expose). Create OAuth 2.0
# credentials at https://console.cloud.google.com/apis/credentials:
#   - Android client (type "Android", package com.healpoint.app): put its ID in
#     EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID. This is the client the physical
#     Android app uses (public installed-app client: PKCE, NO secret anywhere).
#   - iOS client (type "iOS"): put its ID in EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID.
#   - Web client (type "Web application"): put its ID in
#     EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID and the SAME ID + its secret in the
#     backend .env as GOOGLE_WEB_CLIENT_ID / GOOGLE_CLIENT_SECRET. Needed only
#     if a browser flow is used; the native Android flow does NOT need it.
#
# GOOGLE REDIRECT URIS — THE SINGLE MOST COMMON CAUSE OF
#   "Error 400: invalid_request / Access blocked: Authorization error -
#    app does not comply with OAuth policy":
# Google returns that when the app's exact redirect_uri is not listed on the
# client's "Authorized redirect URIs". Add BOTH of these to the Android (and
# any other) client used on a device:
#   - healpoint://oauth2redirect
#     (sent by standalone / dev-client / production builds — scheme from
#     app.json; also registered in the Android manifest's intent filter)
#   - exp://<DEV-MACHINE-LAN-IP>:8081/--/oauth2redirect
#     (sent when running under Expo Go on a physical device)
# The SAME value the app sends is forwarded to the backend
# (POST /api/v1/user/google/login) for the server-side token exchange, so it
# must also match byte-for-byte.
#
# Platform precedence:
#   Android -> EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID   (used on Android)
#   iOS     -> EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID       (used on iOS)
#   Web     -> EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID       (used on web)
#
# Leave the value for the current platform EMPTY to gracefully hide "Continue
# with Google" on that platform (the OR divider + button are not rendered, so
# unconfigured builds can never crash with "androidClientId must be defined").
#
# Backend: put the public Android ID in the backend .env too as
#   GOOGLE_ANDROID_CLIENT_ID=<same public ID above>
# so the server accepts the PKCE exchange and validates the ID-token audience.
# GOOGLE_CLIENT_SECRET only ever exists in the backend .env.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# ---------------------------------------------------------------------------
# Razorpay online payments (optional)
# ---------------------------------------------------------------------------
# The Razorpay Key ID is PUBLIC — it is bundled into the app so the Checkout
# window can open. The matching RAZORPAY_KEY_SECRET must NEVER be put here or
# anywhere in the mobile app; it belongs only on the backend `.env` and is used
# server-side to create orders and verify payment signatures.
#
# The backend normally returns the Key ID alongside each payment order. Set
# this only as a development fallback for backends that do not return it.
# Create keys at: https://dashboard.razorpay.com/app/keys
EXPO_PUBLIC_RAZORPAY_KEY_ID=
